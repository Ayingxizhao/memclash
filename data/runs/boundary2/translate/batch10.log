}"""The fixed word list (vocabulary v2, docs/adr/0008, sections 2-3). Everything a translation
may name is listed here; any other name is an error."""

GIT_CMDS = ["commit", "stage", "push_branch", "push_delete", "force_push", "local_merge",
            "pr_create", "pr_merge", "branch_create", "branch_delete", "checkout", "pull",
            "rebase", "reset_hard", "cherry_pick", "fetch", "worktree_add", "worktree_remove"]
FILE_CMDS = ["read", "create", "edit", "move", "delete"]
CMDS = GIT_CMDS + FILE_CMDS + ["run"]

# Fixed meanings: every kind of push is a push, every kind of merge is a merge. No file groups.
GROUPS = {"push": ["push_branch", "push_delete", "force_push"],
          "merge": ["local_merge", "pr_merge"],
          "any_branch_delete": ["branch_delete", "push_delete"]}

TASKS = ["test", "build", "lint", "format", "deploy", "migrate", "publish", "restart"]
OTHER_TASK = "other:"  # any other task: "other:<exact words>", matched only if identical

# Yes/no fields. The agent decides these as part of the action (it can ask for approval).
ACTION_BOOLS = ["has_secret", "user_confirmed", "files_shown", "secrets_checked",
                "admin_bypass", "in_worktree"]
# Yes/no fields the situation fixes; the agent cannot change them.
WORLD_BOOLS = ["user_asked", "tests_passed"]
BOOLS = ACTION_BOOLS + WORLD_BOOLS

PATH_FIELDS = ["path", "dest_path"]          # targets (patterns.path_re)
BRANCH_FIELDS = ["branch"]                   # globs (patterns.glob_re)
# Details of the earlier step that `after` names (vocabulary v2.1): each refers to the same
# earlier step, one earlier step per action kind.
AFTER_FIELDS = ["after_branch", "after_task", "after_path", "after_ok"]
FILE_ACTIONS = ["read", "create", "edit", "move", "delete", "stage", "commit"]
FIELDS = (["cmd", "path_except", "kind", "task", "suite", "after", "running",
           "min_files", "max_files"] + PATH_FIELDS + BRANCH_FIELDS + AFTER_FIELDS + BOOLS)

# Which fields describe the situation a pair is tested in: see pair.situations.

CLAUSE_TYPES = ["never", "only_if", "must_do", "may_do", "must_hold", "never_hold"]
STATE_TYPES = ["must_hold", "never_hold"]


def expand(names):
    """Action names and groups -> sorted list of actions."""
    out = []
    for n in names if isinstance(names, list) else [names]:
        if n in GROUPS:
            out += GROUPS[n]
        elif n in CMDS:
            out.append(n)
        else:
            raise ValueError(f"unknown action {n!r}")
    return sorted(set(out))


def norm_name(name):
    """Process and task names match only if identical after trivial clean-up:
    case, extra spaces and a leading "the" ("The game server" = "game server")."""
    s = " ".join(str(name).lower().split())
    return s[4:] if s.startswith("the ") else s


def task_name(task):
    t = str(task).strip()
    if t in TASKS:
        return t
    if t.startswith(OTHER_TASK) and len(t) > len(OTHER_TASK):
        return OTHER_TASK + norm_name(t[len(OTHER_TASK):])
    raise ValueError(f"unknown task {task!r}")
"""One action as Z3 variables, and one translated rule as Z3 formulas over it.

A clause's `where` (and `needs`) is a set of fields; `Event.match` turns it into a formula that
is true when the action has those fields. `never` and `only_if` clauses become constraints on
the action (`constraints`). `must_do` / `may_do` are tested by pair.py; `must_hold` /
`never_hold` are repository states, handled by state.py.
"""

from z3 import And, Bool, BoolVal, Implies, InRe, Int, Not, Or, String, StringVal

from rules.patterns import glob_re, target_re
from rules.vocab import (AFTER_FIELDS, BOOLS, BRANCH_FIELDS, CMDS, FIELDS, FILE_ACTIONS, PATH_FIELDS,
                         STATE_TYPES, expand, norm_name, task_name)


def _paths(v):
    """A path pattern may be written as one string or a list; a bare string must not be read
    letter by letter (fix logged in docs/review/boundary_results.md)."""
    return [v] if isinstance(v, str) else list(v)


class Event:
    """Z3 variables for one action; `tag` keeps the actions of different clauses apart."""

    def __init__(self, tag):
        self.tag = tag
        self.cmd = Int(f"{tag}_cmd")
        # which actions happened at some earlier point (several can be true)
        self.prior = {c: Bool(f"{tag}_prior_{c}") for c in CMDS}
        # details of the earlier step of each kind (v2.1): its branch, its path, and for run its
        # task and whether it succeeded
        self.prior_branch = {c: String(f"{tag}_prior_branch_{c}") for c in CMDS}
        self.prior_path = {c: String(f"{tag}_prior_path_{c}") for c in FILE_ACTIONS}
        self.prior_task = String(f"{tag}_prior_task")
        self.prior_ok = Bool(f"{tag}_prior_ok")
        self.n_files = Int(f"{tag}_n_files")
        self.s = {f: String(f"{tag}_{f}") for f in PATH_FIELDS + BRANCH_FIELDS + ["task"]}
        self.b = {k: Bool(f"{tag}_{k}") for k in BOOLS}
        self.is_dir = Bool(f"{tag}_is_dir")
        self.suite_all = Bool(f"{tag}_suite_all")

    def running(self, name):
        """Process `name` is running (one yes/no per name)."""
        return Bool(f"{self.tag}_running_{norm_name(name)}")

    def cond(self, name):
        """An unknown yes/no fact: a condition the rule names but the vocabulary cannot express."""
        return Bool(f"{self.tag}_cond_{name}")

    def wellformed(self):
        return And(self.cmd >= 0, self.cmd < len(CMDS), self.n_files >= 0)

    def is_cmd(self, names):
        return Or([self.cmd == CMDS.index(c) for c in expand(names)])

    def earlier(self, where):
        """An earlier step of one of the `after` kinds, with all the after_* details on that same
        step. Without `after`, the details pick the kinds they can describe."""
        task, path, ok, br = (where.get(k) for k in ("after_task", "after_path", "after_ok", "after_branch"))
        if "after" in where:
            kinds = expand(where["after"])
        else:
            kinds = ["run"] if task is not None or ok is not None else FILE_ACTIONS if path is not None else CMDS
        if (task is not None or ok is not None) and "run" not in kinds:
            raise ValueError("after_task / after_ok need run in after")
        if path is not None and not set(kinds) & set(FILE_ACTIONS):
            raise ValueError("after_path needs a file action in after")
        if ok is not None and not isinstance(ok, bool):
            raise ValueError("after_ok must be true/false")
        opts = []
        for c in kinds:
            if (task is not None or ok is not None) and c != "run":
                continue
            if path is not None and c not in FILE_ACTIONS:
                continue
            f = [self.prior[c]]
            if br is not None:
                f.append(InRe(self.prior_branch[c], glob_re(br)))
            if path is not None:
                f.append(InRe(self.prior_path[c], target_re(path)))
            if task is not None:
                f.append(self.prior_task == StringVal(task_name(task)))
            if ok is not None:
                f.append(self.prior_ok == BoolVal(ok))
            opts.append(And(f))
        return Or(opts)

    def match(self, where):
        cs = []
        if "path_except" in where and "path" not in where:
            raise ValueError("path_except without path")
        if "after" in where or any(k in where for k in AFTER_FIELDS):
            cs.append(self.earlier(where))
        for k, v in where.items():
            if k == "_cond":
                cs.append(self.cond(v))
            elif k not in FIELDS:
                raise ValueError(f"unknown field {k!r}")
            elif k == "cmd":
                cs.append(self.is_cmd(v))
            elif k == "path":
                cs.append(InRe(self.s["path"], target_re(_paths(v), _paths(where.get("path_except", [])))))
            elif k == "dest_path":
                cs.append(InRe(self.s["dest_path"], target_re(_paths(v))))
            elif k == "path_except" or k == "after" or k in AFTER_FIELDS:
                continue  # part of `path` / of the earlier step (self.earlier)
            elif k in BRANCH_FIELDS:
                cs.append(InRe(self.s[k], glob_re(v)))
            elif k == "kind":
                if v not in ("file", "dir"):
                    raise ValueError(f"kind must be file or dir, not {v!r}")
                cs.append(self.is_dir == BoolVal(v == "dir"))
            elif k == "task":
                cs.append(self.s["task"] == StringVal(task_name(v)))
            elif k == "suite":
                if v != "all":
                    raise ValueError(f"suite must be 'all', not {v!r}")
                cs.append(self.suite_all)
            elif k == "running":
                cs.append(And([self.running(n) for n in v]))
            elif k == "min_files":
                cs.append(self.n_files >= int(v))
            elif k == "max_files":
                cs.append(self.n_files <= int(v))
            elif isinstance(v, bool):
                cs.append(self.b[k] == BoolVal(v))
            else:
                raise ValueError(f"{k} must be true/false")
        return And(cs) if cs else BoolVal(True)


def check_clause(c):
    """Rules of the format the schema cannot express on its own."""
    if "cmd" in c.get("needs", {}):
        raise ValueError("an action in needs (write 'before X do Y' as needs after: [Y])")
    if c["type"] == "only_if" and "needs" not in c:
        raise ValueError("only_if without needs")


def action_clauses(clauses):
    out = [c for c in clauses if c["type"] not in STATE_TYPES]
    for c in out:
        check_clause(c)
    return out


def constraints(e, clauses):
    """What `never` and `only_if` clauses demand of action e."""
    out = []
    for c in clauses:
        if c["type"] == "never":
            out.append(Not(e.match(c["where"])))
        elif c["type"] == "only_if":
            out.append(Implies(e.match(c["where"]), e.match(c["needs"])))
    return out


def prepared(clauses, tag):
    """A clause with `when_unmodeled` applies only when an unknown fact of its own holds
    (ADR 0004). No other rule names that fact, so at worst a clash is missed."""
    out = []
    for i, c in enumerate(clauses):
        c = dict(c)
        if c.get("when_unmodeled"):
            c["where"] = {**c["where"], "_cond": f"{tag}{i}"}
        out.append(c)
    return out


def witness(model, e):
    """The action the solver found, in the translation's own field names."""
    out = {"cmd": CMDS[model.eval(e.cmd).as_long()]}
    done = [c for c in CMDS if bool(model.eval(e.prior[c], model_completion=True))]
    if done:
        out["after"] = done
        for c in done:  # details of the earlier steps, where the solver fixed them
            v = model.eval(e.prior_branch[c])
            if hasattr(v, "as_string") and v.as_string():
                out.setdefault("after_branch", v.as_string())
            if c in e.prior_path:
                v = model.eval(e.prior_path[c])
                if hasattr(v, "as_string") and v.as_string():
                    out.setdefault("after_path", v.as_string())
        if "run" in done:
            v = model.eval(e.prior_task)
            if hasattr(v, "as_string") and v.as_string():
                out["after_task"] = v.as_string()
            out["after_ok"] = bool(model.eval(e.prior_ok, model_completion=True))
    for f, v in e.s.items():
        v = model.eval(v)
        if hasattr(v, "as_string") and v.as_string():
            out[f] = v.as_string()
    for k in BOOLS:
        out[k] = bool(model.eval(e.b[k], model_completion=True))
    return out
"""File-name and branch patterns (vocabulary v2, docs/adr/0008, section 4), as Z3 regexes.

Part of pipeline/rules/: the git and file rule checker. pipeline/git/git_check.py stays
unchanged so earlier results can be rerun. Tests: tests/rules/test_patterns.py.
"""

from z3 import (AllChar, Complement, Concat, InRe, Intersect, Option, Re, ReSort, Solver, Star,
                String, StringSort, StringVal, Union, sat)

RE = ReSort(StringSort())
ANY = Star(AllChar(RE))                                  # any text, "/" included
SEG_CHAR = Intersect(AllChar(RE), Complement(Re("/")))   # one character that is not "/"


def is_sat(*fs):
    s = Solver()
    s.add(*fs)
    return s.check() == sat


# ---------------------------------------------------------------- patterns (ADR 0008, section 4)

def glob_re(pattern):
    """Wildcards: `*` = any text inside one folder level, `?` = one character that is not "/",
    `**` = any depth. `a/**/b` also matches `a/b`; `a/**` matches everything inside a/."""
    p, pieces, i = str(pattern), [], 0
    lit = ""
    while i < len(p):
        if p.startswith("**/", i):
            pieces += [Re(lit)] if lit else []
            lit = ""
            pieces.append(Option(Concat(ANY, Re("/"))))  # zero or more folder levels
            i += 3
        elif p.startswith("**", i):
            pieces += [Re(lit)] if lit else []
            lit = ""
            pieces.append(ANY)
            i += 2
        elif p[i] in "*?":
            pieces += [Re(lit)] if lit else []
            lit = ""
            pieces.append(Star(SEG_CHAR) if p[i] == "*" else SEG_CHAR)
            i += 1
        else:
            lit += p[i]
            i += 1
    pieces += [Re(lit)] if lit else []
    if not pieces:
        return Re("")
    return pieces[0] if len(pieces) == 1 else Concat(*pieces)


def path_re(pattern):
    """A path pattern as written by the translator, made canonical in code:
    - paths are relative to the repo root ("./" and a leading "/" are dropped);
    - `X/` is the folder X itself and everything in it;
    - a name with no "/" (`server-world.dat`, `*.md`) matches at any depth."""
    p = str(pattern).strip()
    p = p[2:] if p.startswith("./") else p
    p = p.lstrip("/")
    folder = p.endswith("/")
    bare = "/" not in p          # checked before the trailing "/" is dropped: `vendor/` is not bare
    p = p.rstrip("/")
    if bare:
        p = "**/" + p
    r = glob_re(p)
    return Union(r, glob_re(p + "/**")) if folder else r


def target_re(include, exclude=()):
    """In some include pattern and in no exclude pattern (order never matters, no `!`)."""
    r = Union(*[path_re(x) for x in include]) if len(include) > 1 else path_re(include[0])
    if exclude:
        ex = Union(*[path_re(x) for x in exclude]) if len(exclude) > 1 else path_re(exclude[0])
        r = Intersect(r, Complement(ex))
    return r


def matches(regex, text):
    v = String("probe")
    return is_sat(v == StringVal(text), InRe(v, regex))
# 0003. A clash means no single action satisfies both rules; "may" is a strong permission

Date: 2026-11-19. Status: Accepted.

## Context
Labelling showed that readers used different meanings of "clash". Two candidates:
1. "Following one rule can break the other." Taken literally, almost every pair clashes through
   details neither rule mentions (for example the timing of "prune after each clone batch").
2. "In some situation, no single action satisfies both rules." This is the standard meaning of
   inconsistency, and Z3 can answer it exactly.

Under (2), the reading of "may" decides pairs such as "create PRs with MCP" vs "you may also
create PRs with gh-cc-var". In deontic logic (the logic of obligation and permission), von Wright
separates a weak permission (merely not forbidden) from a strong permission (explicitly stated
by the rules). Vranes (2006) argues that a norm conflict covers obligation vs prohibition,
obligation vs permission not to act, and prohibition vs permission. Norm-conflict checkers in
multi-agent systems (Vasconcelos, Kollingbaum & Norman, 2008) also treat permission vs
prohibition as a conflict.

## Decision
Two rules clash if, in some situation the rules name, no single action satisfies both. The
words that set a rule's force are read as follows:

| Words | Meaning | Clause |
|---|---|---|
| must, always, do X | obligation | `must_do` |
| never, don't, avoid | prohibition | `never` |
| may, it's fine to, permit | strong permission: the action must stay possible | `may_do` |
| only if, not without, before X do Y | conditional obligation | `only_if` |

An explicit "may" in a memory rule is a strong permission, because the rule states it. "Use M
for X" read together with "use G for X" is a clash when the agent uses one tool per task
(indirect conflict: it depends on knowing that the two options exclude each other, and that,
for example, a lookup is a kind of read).

## Consequences
- An exception written as a permission ("you may skip dev-bot testing for test-only PRs")
  clashes with the rule it excepts. This is intended: the agent must know which rule wins.
- The checker already treats `may_do` as a strong permission.
- Sources (abstracts and summaries only, to be read in full before citing): Vranes 2006, EJIL
  17:395; Vasconcelos, Kollingbaum & Norman 2008, JAAMAS; Torres da Silva et al. 2015 on
  indirect conflicts; von Wright 1951/1968 via secondary sources.
# 0004. Conditions the model cannot express become unknown facts

Date: 2026-11-19. Status: Accepted.

## Context
On the large folders, the first translations reported 20 clashes, all false. One cause: the
translator dropped conditions it could not express, so "never commit to the local clones" became
"never commit", which then clashed with every rule that requires a commit.

## Decision
A condition the model cannot express ("in the local clones", "during a backlog sweep") is kept
as `when_unmodeled`. The checker turns it into a fresh unknown yes/no fact for that clause, so
the clause applies only when that fact holds. An `only_if` whose requirement cannot be expressed
becomes an unknown requirement the agent can meet.

Rule of thumb: dropping a requirement can only cause missed clashes; dropping a condition causes
false clashes. So conditions are never dropped.

## Consequences
- False clashes on the large folders went from 20 to 0.
- Known blind spot: two rules naming the same unexpressible condition get two different unknown
  facts, so their clash is missed (for example "during a sweep, review" vs "during a sweep, never
  review"). A fix is to let rules that name the same condition share one fact.
# 0008. One fixed vocabulary for git and basic file rules

Date: 2026-11-22. Status: Accepted. Extends 0002.

## Context
The survey of 60 more memory folders found that besides git, rules about files (read, create,
edit, move, delete, what stays in the repo) and about running commands are common and can be
written in a fixed form without knowing tool names. Two research reports
(`docs/review/schema_research_*.md`) found that comparable systems (GitHub rulesets, Claude
Code permissions, Cedar, AppArmor) all fix the action list in code and leave only names open.
Two critical reviews (`docs/review/attack_review_*.md`) asked that every item be justified and
that ambiguous words not be decided silently.

## Decision
- The vocabulary is `docs/review/vocab_draft.md` v2, written by Claude and Codex in five review
  rounds and approved by the author. It is fixed in code for the experiment; changes need a
  new version.
- Scope: git rules plus basic file rules and `run` with a fixed task list. If the file part
  gives poor results, it is dropped from the report.
- Words with more than one meaning are read from the rule's own text; if unclear, the rule is
  excluded and listed with the word.
- "In the repo" is a state. Opposite state requirements are reported as a separate verdict,
  "state conflict"; 0003 is unchanged.
- "May" vs "never" / "must" pairs are reported as their own category, "exception (needs a
  priority rule)", next to plain clashes.
- The translator sees only the rule, its file name and its section heading, not the folder's
  other rules, so that other rules cannot change how a rule is read.
- Claims say "solver-checked": exact with respect to the translations.

## Consequences
- The checker and prompt changes in section 8 of the vocabulary must be made before any
  translation run.
- Some rules a reader would understand from the folder become unclear; their number is reported.
- The held-out folders were selected with a git filter (0005), so the held-out claim stays
  git-only. File rules are reported on the survey folders, with three-run agreement and a
  hand-checked sample.
