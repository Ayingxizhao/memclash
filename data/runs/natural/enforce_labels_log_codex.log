{"folder":"jamieleecho__space-bandits","rules":[{"id":"R3","rule":"A sprite group JSON may reference its own PNG file."},{"id":"R114","rule":"After editing the Xcode project file, always validate it with `plutil -lint \"Space Bandits/Space Bandits.xcodeproj/project.pbxproj\"`."},{"id":"R89","rule":"A tileset may contain at most 127 unique tiles."},{"id":"R85","rule":"When adding a new level, provide a 132x96 indexed PNG level image at `game/images/XX-levelN.png`."},{"id":"R28","rule":"When adding a complete new level and adding new objects, create or modify the object code files game/objects/XX-name.c and .h."},{"id":"R81","rule":"When adding a new object, create `game/objects/XX-name/` with a JSON descriptor and C or ASM source."},{"id":"R88","rule":"When adding a new tileset, add its PNG and JSON files to `game/tiles/`."},{"id":"R60","rule":"When adding a new sound, add the WAV file to `game/sounds/` using `XX-name.wav` naming, where `XX` is the next number."},{"id":"R54","rule":"All objects should read `Gfx_BkgrndNewX` when calculating screen-relative positions."},{"id":"R18","rule":"If the level JSON InitData is empty, set DynospriteObject_InitSize to 0."}]}
