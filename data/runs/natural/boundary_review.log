lo-patch","id":"R179","exact":true,"note":"It forbids commits containing secrets or credentials and commits targeting .env at any depth."},{"folder":"sparkling__ruflo-patch","id":"R194","exact":false,"note":"It requires the successful build to be the newest run, which the English rule does not."},{"folder":"sparkling__ruflo-patch","id":"R203","exact":true,"note":"It forbids commits targeting .env and every commit containing secrets."},{"folder":"sparkling__ruflo-patch","id":"R217","exact":false,"note":"It forbids polling only when spawning is the newest run, not every later poll."},{"folder":"sparkling__ruflo-patch","id":"R224","exact":true,"note":"Plugin installation requires approval of that exact action."},{"folder":"sparkling__ruflo-patch","id":"R235","exact":false,"note":"The generic bootstrap task does not preserve the rule's exact command-line scope."}]}
